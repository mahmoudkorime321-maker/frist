<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Input Tools -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="Rows (m):" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtRows" Width="50" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="Columns (n):" VerticalAlignment="Center" Margin="15,5,5,5"/>
            <TextBox x:Name="txtCols" Width="50" Margin="5" TextAlignment="Center"/>
            <Button Content="Generate Matrix" Click="GenerateMatrix_Click" Padding="10,5" Margin="15,0,0,0"/>
        </StackPanel>

        <!-- Matrix Grid -->
        <UniformGrid x:Name="MatrixGrid" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- Control Panel -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Center">
            <!-- Step Description -->
            <TextBlock x:Name="txtStepDescription" Text="Enter numbers and click 'Solve'" 
                       FontSize="16" FontWeight="Bold" Foreground="DarkBlue" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <!-- Navigation Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Previous" Click="BtnPrev_Click" Width="80" Margin="5" Padding="5"/>
                <Button Content="Solve" Click="BtnSolve_Click" Width="100" Margin="15,5,15,5" Padding="5" Background="LightGreen"/>
                <Button Content="Next" Click="BtnNext_Click" Width="80" Margin="5" Padding="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
